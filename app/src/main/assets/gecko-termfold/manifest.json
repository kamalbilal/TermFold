{
  "manifest_version": 2,
  "name": "TermFold Browser",
  "version": "1.0.0",
  "description": "In-page automation bridge for TermFold agents",
  "applications": {
    "gecko": {
      "id": "termfold@termfold",
      "strict_min_version": "121.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject-tf.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
