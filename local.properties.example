# Copy to local.properties (gitignored). Optional override for signing.

sdk.dir=/path/to/android-sdk
# Optional on this fork:
# android.aapt2FromMavenOverride=/path/to/Termfold/.tools/aapt2

# Default signing for com.termfold.app is in .termfold/ (committed on this private repo):
#   .termfold/termfold-release.jks
#   .termfold/signing.properties
# Uncomment here only to override:
# termfold.storePassword=
# termfold.keyPassword=
# Or env: TERMFOLD_STORE_PASSWORD, TERMFOLD_KEY_PASSWORD
