# Copy to local.properties (gitignored). Never commit real passwords or *.jks.

sdk.dir=/path/to/android-sdk
# Optional on this fork:
# android.aapt2FromMavenOverride=/path/to/Termfold/.tools/aapt2

# Production signing for com.termfold.app (same cert as GitHub/Play — in-place update, data kept):
# 1. Put termfold-release.jks in repo root (see tools/make-keystore.ps1 only for NEW keys).
# 2. Uncomment and fill:
# termfold.storePassword=
# termfold.keyPassword=
# Or env: TERMFOLD_STORE_PASSWORD, TERMFOLD_KEY_PASSWORD
